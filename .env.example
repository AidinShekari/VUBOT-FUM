# Messaging Platform
API_PROVIDER=BALE                       # BALE, TELEGRAM, or BOTH (default: BALE)
BALE_API_BASE_URL=                      # Optional: custom Bale-compatible API URL
TG_API_BASE_URL=                        # Optional: custom Telegram-compatible API URL
USE_PREMIUM_EMOJI=true                  # Telegram-only premium <tg-emoji>; requires a Fragment username on the bot. Set false to send plain emoji.

# Bot Configuration
BALE_BOT_TOKEN=your_bale_bot_token
TG_BOT_TOKEN=your_telegram_bot_token
GLOBAL_CHAT_ID_BALE=your_bale_chat_id   # Main Bale chat for all notifications
GLOBAL_CHAT_ID_TG=your_telegram_chat_id # Main Telegram chat for all notifications
TOPIC_ID=                               # Optional: for forum groups
ADMIN_CHAT_ID=                          # For captcha handling
BOT_POLLING=false                       # Optional: only enable if you add inbound bot handlers

# Telegram Proxy
TG_SOCKS_PROXY=                         # Optional: socks5://user:pass@host:port
HTTP_PROXY=                             # Optional: HTTP proxy for bot requests

# Course Configuration (JSON format - recommended)
COURSES='[{"url":"https://vu.um.ac.ir/course/view.php?id=12345","chatid_bale":"optional_bale_chat","chatid_tg":"optional_telegram_chat"}]'

# Or legacy format (comma-separated)
# COURSE_URLS=https://vu.um.ac.ir/course/view.php?id=12345
# COURSE_CHAT_IDS_BALE=
# COURSE_CHAT_IDS_TG=

# VU Login
VU_USERNAME=your_vu_username
VU_PASSWORD=your_vu_password

# Other Settings
CHECK_INTERVAL=5                        # Minutes between checks (default: 5)
DEBUG_MODE=false
CHROME_PATH=                            # Optional: Chrome executable path
